APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Ships false: a production deploy that forgets to override this must NOT leak
# stack traces + env values. Set true only in local .env when debugging.
APP_DEBUG=false
APP_URL=http://localhost

# Release identity, stamped by the deploy from the git tag and the commit it was
# cut from. Left empty locally: `GET /v1/version` then reports an empty version
# rather than a guess. APP_UPSTREAM records which template release this site
# forked from — what the Hub reads to spot a site that has drifted from cetakan.
APP_VERSION=
APP_COMMIT=
APP_UPSTREAM=

# CORS: comma-separated allowlist of frontend origins (admin, storefront,
# payment). Leave unset for local dev to allow any origin ('*').
CORS_ALLOWED_ORIGINS=

# Proxies whose X-Forwarded-* headers we believe. Empty = trust none, which is
# right for a box addressed directly. Fill it in once the site sits behind nginx
# or a load balancer: without it `$request->ip()` is the proxy's address, so
# HUB_ALLOWED_IPS and the uxiolabs webhook's IP allowlist reject every
# legitimate call, and every per-IP rate limit shares one bucket. Comma-separated
# IPs/CIDRs, or `*` for a proxy we control whose address moves — never `*` on a
# directly reachable host, or a caller can spoof X-Forwarded-For past all of it.
TRUSTED_PROXIES=

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=web_topup_api
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Consumer storefront base URL — used for the "Track Order" link in the receipt email.
# Where customers and clients are sent. These values are for LOCAL DEV ONLY —
# in production they must be the live domains, or `urls:verify` fails the deploy.
# They have no fallback in config/services.php on purpose: an unset variable used
# to become `http://localhost:5173`, which is how a refund claim link pointing at
# a developer's machine was sent to a real buyer over WhatsApp.
PAYMENT_PAGE_URL=http://localhost:5174
STOREFRONT_URL=http://localhost:5173
STOREFRONT_BRAND="TopupGame by Uxiolabs"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Adapter payment gateway untuk situs ini — kuncinya ada di config/services.php
# -> payment.adapters (default `monetapay`). Menambah gateway berarti menambah
# satu kelas adapter + satu baris di sana; checkout, payout, dan callback tidak
# disentuh (App\Contracts\PaymentGateway).
PAYMENT_DRIVER=monetapay

MONETAPAY_MCH_ID=
# Blank = trade as the main merchant (pre-sub-merchant behaviour).
MONETAPAY_SUB_MCH_ID=
MONETAPAY_COLLECTION_APP_ID=
MONETAPAY_PARTNER_KEY=
MONETAPAY_TOKEN=
MONETAPAY_AES_KEY=
MONETAPAY_AES_IV=
# Kredensial jalur PENCAIRAN (disbursement). Monetapay bisa menerbitkan app
# terpisah untuk payout, jadi kelimanya punya fallback ke kredensial collection di
# atas (app_id → MONETAPAY_MCH_ID, partner_key/token/aes_key/aes_iv → pasangannya).
#
# DIBIARKAN TERKOMENTAR ON PURPOSE — jangan di-uncomment lalu dibiarkan kosong.
# Di Laravel modern `KEY=` yang kosong terbaca sebagai string kosong, BUKAN
# "tidak diisi", jadi fallback-nya tidak jalan: `MONETAPAY_DISBURSEMENT_PARTNER_KEY=`
# akan mengirim partner key kosong dan gateway menolak setiap payout. Isi kelima
# baris ini hanya kalau Monetapay memang memberi app disbursement tersendiri —
# dan isi kelimanya, karena fallback-nya per kunci, bukan per blok.
# MONETAPAY_DISBURSEMENT_APP_ID=
# MONETAPAY_DISBURSEMENT_PARTNER_KEY=
# MONETAPAY_DISBURSEMENT_TOKEN=
# MONETAPAY_DISBURSEMENT_AES_KEY=
# MONETAPAY_DISBURSEMENT_AES_IV=
MONETAPAY_IS_PRODUCTION=false
MONETAPAY_SUCCESS_REDIRECT_URL=
MONETAPAY_FAILED_REDIRECT_URL=

# Withdrawal (payout) fee — a flat charge on every merchant withdrawal, amount-independent:
# fee = WITHDRAWAL_FEE_FLAT + round(WITHDRAWAL_FEE_FLAT * WITHDRAWAL_FEE_PERCENT / 100)
#     = 1500 + 165 = 1665; nett = amount - fee.
# WITHDRAWAL_MIN_AMOUNT must exceed the fee so nett stays positive.
WITHDRAWAL_FEE_FLAT=1500
WITHDRAWAL_FEE_PERCENT=11
WITHDRAWAL_MIN_AMOUNT=10000
# Fraud buffer on top of each channel's settlement window (T+n). A sale is
# withdrawable after settlement_days + this many days: VA holds H+1, QRIS H+2,
# OVO/ShopeePay H+3, retail H+4.
WITHDRAWAL_HOLD_BUFFER_DAYS=1

# Uxio Hub (internal cross-site panel). Data only ever moves on a GET the
# receiver made itself: the Hub pulls /v1/hub/* here with X-Hub-Key, this site
# pulls catalog + channel fees from HUB_BASE_URL with the same key. The Hub also
# POSTs /v1/hub/sync — a bare "config changed, come and get it" with no payload,
# gated by the read key, so an edit lands in seconds instead of a minute.
# That needs the queue worker AND the schedule:run cron; without them the sync
# is whatever you run by hand. Key is generated by the Hub per site and shown
# once. Leave HUB_ENABLED=false on a standalone deployment.
HUB_ENABLED=false
HUB_SITE_API_KEY=
HUB_BASE_URL=
HUB_ALLOWED_IPS=
# The Hub contract version this site speaks (/v1 today). The Hub serves sites at
# mixed versions, so it checks this against its own minimum supported version —
# the warning bell before a site falls behind a breaking change.
HUB_CONTRACT_VERSION=v1
HUB_MANAGED_CATALOG=true
# Refuses local edits for channels the sync actually writes (payment_channels
# .hub_managed). Site-only channels like `balance` stay editable here — the
# Hub's master holds only the Monetapay-contracted codes.
HUB_MANAGED_CHANNELS=true
# The Hub owns this site's licence and can switch the public side off with it.
# A site is DARK BY DEFAULT: until `hub:sync-licence` has landed an answer that
# says it may serve, every public route answers 503. Only an explicit "serving"
# from the Hub opens it (a serving site stays serving through a Hub outage —
# the answer is stored, and nothing rewrites it). Set false to roll that whole
# mechanism back: the gate goes inert, the sync stops writing, and the site
# bills itself exactly as it did before.
HUB_MANAGED_LICENCE=true
# The Hub's service plan -> this site's own bills (`hub:sync-plan`). OFF by
# default and separate from HUB_ENABLED because this one ISSUES INVOICES: the
# cutover is per site and must be stoppable in one env change. On a Hub-managed
# deployment the schedule is not even registered without it, so a missing line
# here reads as "the client was never billed" — and the Hub says so out loud
# when you press "Kirim Tagihan".
HUB_MANAGED_PLAN=false
# How often this site re-pulls from the Hub (catalog, channels, licence, plan).
# One minute by default, so a change made in the Hub reaches the client's site —
# and the client's bill — while the operator is still watching. Raise it if a
# deployment would rather pull more gently; a Hub poke is unaffected and still
# lands in about a second.
HUB_SYNC_INTERVAL_MINUTES=1
# Real-time push of a merchant's service order to the Hub. Left OUT on purpose:
# it defaults to HUB_ENABLED, and an empty `HUB_PUSH_ORDERS=` reads as "" — i.e.
# false — which would silently disable the push. Uncomment only to force it.
# HUB_PUSH_ORDERS=false
# Money-path write channel (the Hub approving/rejecting withdrawals and
# confirming/rejecting service invoices here). Off by default and gated by a
# SECOND key — minted with POST /v1/hub/sites/{site}/regenerate-write-key.
HUB_WRITE_ENABLED=false
HUB_WRITE_API_KEY=

# Adapter supplier top-up untuk situs ini — kuncinya ada di config/services.php
# -> supplier.adapters (default `uxiolabs`). Menambah supplier berarti menambah
# satu kelas adapter + satu baris di sana; engine transaksi
# (App\Contracts\SupplierGateway) tidak disentuh.
SUPPLIER_DRIVER=uxiolabs

UXIOTOPUP_API_KEY=
UXIOTOPUP_BASE_URL=https://api.uxiotopup.id
UXIOTOPUP_CALLBACK_URL=
UXIOTOPUP_PRICE_TIER=harga
UXIOTOPUP_CALLBACK_IP=103.146.202.50
# Berapa lama daftar harga tersimpan masih dianggap layak saat cek harga live di
# checkout gagal (menit). Samakan dengan jeda sweep.
UXIOTOPUP_RECHECK_FRESH_MINUTES=5

DISCORD_WEBHOOK_LOG_URL=
# Leave false anywhere that is not the live site. Seeders and fixtures fire the
# same notifications real traffic does, and they drown the channel.
DISCORD_SEND_OUTSIDE_PRODUCTION=false
# all | failures | off — how much of the invoice-delivery trail goes to Discord
DISCORD_INVOICE_LOG=all

# Google Sign-In — OAuth Client ID (Web application) from Google Cloud Console.
# Same value the frontend sets as VITE_GOOGLE_CLIENT_ID. No client secret needed.
GOOGLE_CLIENT_ID=

# PiWAPI (WhatsApp gateway — delivers the purchase receipt as a document)
# Usually set from the admin Integration page; these are the env fallbacks.
# OFF by default: WhatsApp delivery is part of the future subscription, so
# nothing goes out over WhatsApp while this is false. Email is unaffected.
# Set true to switch WhatsApp back on once the subscription is in place.
PIWAPI_ENABLED=false
PIWAPI_API_URL=https://piwapi.com/api/send/whatsapp
PIWAPI_ACCOUNT=
PIWAPI_SECRET=

# Pusher (hosted, pusher.com) — WebSocket broadcasting. There is NO self-hosted
# WebSocket server any more; all realtime goes through the external Pusher
# platform. Create an app at dashboard.pusher.com and copy its credentials here.
# IMPORTANT: do NOT wrap values in quotes — a quoted key bakes the quotes into
# the frontend build and pusher-js can never authenticate with it.
PUSHER_APP_ID=2086577
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1

# Exposed to the Vite frontends (laravel-echo). Mirror the values above (no quotes).
VITE_PUSHER_APP_KEY=${PUSHER_APP_KEY}
VITE_PUSHER_APP_CLUSTER=${PUSHER_APP_CLUSTER}
